# Agent Hub — environment template
# Copy to .env and adjust. Never commit real secrets.
#   cp .env.example .env
#
# Every variable below is read by the code. Anything not listed here is not a
# setting — the app has no hidden knobs.

# -----------------------------------------------------------------------------
# Auth / JWT  (read by the api process)
# -----------------------------------------------------------------------------
# Long random secret used to sign JWTs. Generate e.g.:
#   openssl rand -base64 48
# The API logs a warning at startup while this is the published demo value.
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime. forever|0|never|none = no expiry (default: long
# terminal sessions do not get logged out). Or a Go duration: 15m, 24h, 168h
JWT_ACCESS_TTL=forever

# Bootstrap admin. Created on first start. Changing this value and restarting
# re-applies it to the account — that is the password recovery path. Leaving it
# unchanged does NOT overwrite a password the admin later set in Settings.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=123456

# -----------------------------------------------------------------------------
# Server / storage  (read by the api process)
# -----------------------------------------------------------------------------
# HTTP listen address inside the container/process.
HTTP_ADDR=:27341

# Persistent store directory (Compose mounts a volume at /data). Holds SSH
# passwords and private keys in plaintext — treat it as a secret (D-009).
DATA_DIR=/data

# Access policy default recorded in Settings: true prefers Tailscale / private
# mesh clients. Recorded intent, not enforcement — secure the edge yourself.
ACCESS_DEFAULT_TAILSCALE_ONLY=false

# -----------------------------------------------------------------------------
# Tailscale machine import — optional (Machines page → "Import from Tailscale")
# -----------------------------------------------------------------------------
# API access token from https://login.tailscale.com/admin/settings/keys
# (an API token, not a node auth key). Empty = the import UI stays hidden.
# TAILSCALE_API_KEY=tskey-api-xxxxxxxx
# Tailnet for that token; "-" (default) means the token owner's own tailnet.
# TAILSCALE_TAILNET=-

# -----------------------------------------------------------------------------
# Compose only  (host port publishing and the web image build)
# -----------------------------------------------------------------------------
# Defaults avoid the usual 8080 / 5173 / 22 clashes.
API_PORT=27341
WEB_PORT=27342
# Dummy SSH target for the demo / e2e (deploy/ssh-target, login root/targetpass).
SSH_TARGET_PORT=27343

# Browser-facing API origin, baked into the SPA at build time. Leave EMPTY for
# same-origin (the web container proxies /api and /health) — correct behind any
# reverse proxy. A localhost value here makes deployed pages call the visitor's
# own machine, so the app ignores localhost values.
VITE_API_BASE_URL=
