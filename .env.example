# Agent Hub — environment template
# Copy to .env and adjust. Never commit real secrets.
#   cp .env.example .env

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Runtime environment: development | production
APP_ENV=development

# Public base URL clients use (local or your deployed host)
# Examples: http://localhost:8080  |  https://agent-hub.example
APP_BASE_URL=http://localhost:8080

# HTTP listen address inside the container/process
HTTP_ADDR=:8080

# Compose host port mappings (optional overrides)
API_PORT=8080
WEB_PORT=5173

# Browser-visible API origin baked into the web image at build time
VITE_API_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------
# Long random secret used to sign JWTs. Generate e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime. forever|0|never = no expiry (default for long terminal sessions).
# Or a Go duration: 15m, 24h, 168h
JWT_ACCESS_TTL=forever

# Bootstrap admin seed (created on first start only if this username is missing).
# Demo defaults for open-source / local try-out — change before any real deploy.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=123456

# Dummy SSH target host port (Compose service ssh-target)
SSH_TARGET_PORT=2222

# -----------------------------------------------------------------------------
# Database (engine TBD — placeholders for Compose)
# -----------------------------------------------------------------------------
# sqlite path or postgres DSN, depending on implementation choice
DATABASE_URL=sqlite:///data/agent-hub.db
# DATABASE_URL=postgres://agent_hub:change-me@db:5432/agent_hub?sslmode=disable

# -----------------------------------------------------------------------------
# Access policy defaults (app may override via Settings)
# -----------------------------------------------------------------------------
# When true, prefer restricting to Tailscale / private mesh clients.
# Local e2e does not require Tailscale — default false for compose.
ACCESS_DEFAULT_TAILSCALE_ONLY=false

# Optional: trust Tailscale identity headers / WhoIs (details TBD)
# TAILSCALE_AUTH_ENABLED=true

# -----------------------------------------------------------------------------
# Terminal bridge — SSH by IP (ADR-005)
# -----------------------------------------------------------------------------
# Register machines with address=ssh-target (in Compose network) or host IP.
# Dummy target credentials (deploy/ssh-target): root / targetpass

# -----------------------------------------------------------------------------
# Logging / audit
# -----------------------------------------------------------------------------
LOG_LEVEL=info
# AUDIT_RETENTION_DAYS=90
